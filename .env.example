JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
# Token is NOT here. It goes in the OS keychain via the app's auth screen.

DATABASE_URL=sqlite:///./data/tracker.db
APP_PORT=8756

# Secret storage: auto tries the OS keychain and falls back to a 0600 file in
# your home dir if no keychain backend exists (e.g. headless WSL).
SECRET_BACKEND=auto

AI_PROVIDER=ollama          # ollama | gemini | groq | none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# GEMINI_API_KEY and GROQ_API_KEY also go in the keychain, not here

EMBEDDING_MODEL=all-MiniLM-L6-v2
GIT_REPO_PATHS=/home/me/work/payments,/home/me/work/gateway
IDLE_THRESHOLD_MINUTES=15
NUDGE_TIME=18:00
TIMEZONE=Asia/Kolkata
