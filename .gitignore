# Python
backend/.venv/
__pycache__/
*.pyc
*.egg-info/
backend/data/*.db
backend/data/*.db-journal
backend/logs/
.pytest_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Desktop / packaging build artifacts (generated by build_backend.ps1 /
# electron-builder; only the source .spec/.ps1/main.js etc. are tracked)
backend/packaging/build/
backend/packaging/dist/
desktop/node_modules/
desktop/release/

# Env and secrets (the token lives in the OS keychain, never a file in the repo)
.env
*.local

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code local settings (machine-specific permission allowlist)
.claude/settings.local.json
